{
  "manifest_version": 3,
  "name": "ClipScribe",
  "version": "0.1.1",
  "description": "Highlight the web. Build your research document.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["http://127.0.0.1:8765/*", "http://localhost:8765/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "ClipScribe",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
